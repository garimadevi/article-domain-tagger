# Copy to .env for local dev, or set VITE_API_URL in Netlify dashboard:
# Site settings -> Environment variables -> VITE_API_URL = your backend URL.
# Example: VITE_API_URL=https://article-domain-tagger.onrender.com
# Leave empty for local dev (vite proxies /predict to localhost:8000).
VITE_API_URL=
